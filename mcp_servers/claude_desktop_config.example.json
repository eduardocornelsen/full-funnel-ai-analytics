{
  "_comment": "Claude Desktop requires absolute paths. Replace /ABSOLUTE/PATH/TO/full-funnel-ai-analytics with the directory you cloned this repo into (run `pwd` inside the repo). Claude Code users don't need this file — the repo's .mcp.json uses relative paths and works as-is.",
  "mcpServers": {
    "google-ads": {
      "command": "python",
      "args": ["/ABSOLUTE/PATH/TO/full-funnel-ai-analytics/mcp_servers/mock_google_ads_server.py"]
    },
    "meta-ads": {
      "command": "python",
      "args": ["/ABSOLUTE/PATH/TO/full-funnel-ai-analytics/mcp_servers/mock_meta_ads_server.py"]
    },
    "ga4": {
      "command": "python",
      "args": ["/ABSOLUTE/PATH/TO/full-funnel-ai-analytics/mcp_servers/mock_ga4_server.py"]
    },
    "hubspot": {
      "command": "python",
      "args": ["/ABSOLUTE/PATH/TO/full-funnel-ai-analytics/mcp_servers/mock_hubspot_server.py"]
    },
    "salesforce": {
      "command": "python",
      "args": ["/ABSOLUTE/PATH/TO/full-funnel-ai-analytics/mcp_servers/mock_salesforce_server.py"]
    },
    "analytics": {
      "command": "python",
      "args": ["/ABSOLUTE/PATH/TO/full-funnel-ai-analytics/mcp_servers/analytics_server.py"]
    },
    "bigquery": {
      "command": "uvx",
      "args": ["mcp-server-bigquery", "--project", "YOUR_PROJECT_ID"]
    },
    "dbt-semantic-layer": {
      "command": "uvx",
      "args": ["dbt-mcp", "--project-dir", "/ABSOLUTE/PATH/TO/full-funnel-ai-analytics/dbt_project", "--profiles-dir", "/ABSOLUTE/PATH/TO/full-funnel-ai-analytics/dbt_project", "--target", "duckdb"]
    }
  }
}
