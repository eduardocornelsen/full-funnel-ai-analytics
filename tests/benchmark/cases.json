{
  "_meta": {
    "version": "2.0",
    "note": "SQRA v2 cases: dates are anchor-relative tokens resolved from golden _meta at load time; expected values resolve from the golden artifact (expected_ref) so each surface is a cross-implementation check that survives the daily-growing dataset. Adversarial cases carry the CANONICAL expected value — detection is divergence on merit, not a label."
  },
  "cases": [
    {
      "id": "mcp_ga4_total_sessions_90d",
      "surface": "mcp",
      "question": "Total sessions across all channels for the 90-day window",
      "tool": "ga4.get_traffic_by_channel",
      "params": {
        "start_date": "$window_start",
        "end_date": "$window_end"
      },
      "extract": {
        "op": "sum",
        "field": "sessions"
      },
      "tolerance": {
        "type": "count",
        "value": 1
      },
      "relevance_check": {
        "type": "date_params_present"
      },
      "tags": [
        "ga4",
        "sessions",
        "funnel"
      ],
      "expected_ref": {
        "golden_path": "windowed_90d.sessions.total"
      }
    },
